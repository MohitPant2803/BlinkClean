{
  "expo": {
    "name": "BlinkClean",
    "slug": "blinkclean",
    "version": "1.0.0",
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.mohit_builds.gallerytinder"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BlinkClean to access your photos.",
          "savePhotosPermission": "Allow BlinkClean to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
